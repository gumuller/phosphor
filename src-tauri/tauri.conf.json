{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phosphor", "version": "0.1.0", "identifier": "com.phosphor.notes",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Phosphor", "width": 1340, "height": 880, "minWidth": 760, "minHeight": 560, "backgroundColor": "#0a100c" }], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": false }
}
